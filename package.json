{
  "name": "revenuepilot-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/api.mjs",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write apps packages scripts tests docs *.json *.ts *.yaml *.yml *.md",
    "contracts": "node --import tsx scripts/export-contracts.ts",
    "test:stack": "node scripts/smoke-stack.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1167.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "bootstrap": "5.3.9",
    "bullmq": "6.7.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.72.0",
    "mongoose": "9.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
