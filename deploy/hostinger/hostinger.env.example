# Public target selected by Siva. Copy to .env.hostinger on the deployment host.
REVENUEPILOT_DOMAIN=revenuepilot.codebegun.com
WEB_ORIGIN=https://revenuepilot.codebegun.com
REVENUEPILOT_EXPECTED_IPV4=200.97.164.244
REVENUEPILOT_HTTP_PORT=8081
REVENUEPILOT_NETWORK_SUBNET=172.30.84.0/24
TRUST_PROXY_CIDRS=172.30.84.0/24

# Required dedicated, authenticated TLS endpoints. Supply securely on the host.
# MongoDB must be a replica set (transactions); no existing LMS resources.
MONGODB_URI=
REDIS_URL=
# Stable 32-byte random key as 64 hexadecimal characters. Preserve with backups.
DATA_ENCRYPTION_KEY=
ALLOW_REGISTRATION=false
ALLOW_LIVE_PROVIDERS=false
ALLOW_ACCOUNT_EMAIL=false
