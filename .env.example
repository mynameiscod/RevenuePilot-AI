NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/revenuepilot?replicaSet=rp-rs&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
# Generate with npm run setup:env. Required: 32 random bytes encoded as 64 hex characters.
DATA_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3001
API_PORT=4000
ALLOW_REGISTRATION=true
REVENUEPILOT_DEMO=false
# External side effects are off until explicitly configured.
ALLOW_LIVE_PROVIDERS=false
ALLOW_ACCOUNT_EMAIL=false
# Set only when account mail is enabled; AWS credentials use the SDK default chain.
# ACCOUNT_EMAIL_FROM=accounts@your-domain.example
AWS_REGION=ap-south-1
# Platform SaaS billing is separate from tenant payment connections.
# BILLING_STRIPE_SECRET_KEY=
# BILLING_STRIPE_WEBHOOK_SECRET=
# BILLING_PRICE_GROWTH=
# BILLING_PRICE_SCALE=
